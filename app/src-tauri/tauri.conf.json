{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app-template",
  "mainBinaryName": "tauri-app-template",
  "version": "0.0.1",
  "identifier": "com.mcgeq.qianyu",
  "build": {
    "beforeDevCommand": "cd .. && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd .. && pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "__TAURI_UPDATER_PUBKEY__",
      "endpoints": [
        "__TAURI_UPDATER_ENDPOINT__"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tauri-app-template",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
