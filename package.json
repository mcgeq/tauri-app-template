{
  "name": "tauri-app-template-workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-react/eslint-plugin": "^5.8.12",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "lint-staged": "^17.0.7",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && cd app/src-tauri && cargo fmt --check 2>nul || (echo Warning: Rust formatting check failed. Run cargo fmt to fix. & exit 0)",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "app/src/**/*.{ts,tsx}": "eslint --fix",
    "app/src-tauri/**/*.{rs}": "",
    "*.{css,json,md}": "eslint --fix"
  }
}
