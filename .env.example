# ── Frontend / Tauri ──────────────────────────────────
# Tauri dev server host (default: localhost)
# Set to 0.0.0.0 to allow access from other devices on the network
TAURI_DEV_HOST=

# ── Server (axum) ─────────────────────────────────────
# Copy server/.env.example to server/.env and adjust:
#   HOST=127.0.0.1
#   PORT=3000
#   DATABASE_URL=postgres://user:password@localhost:5432/tauri_app_template
